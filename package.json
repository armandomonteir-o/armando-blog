{
  "name": "armando-blog",
  "version": "0.1.0",
  "private": true,
  "description": "Personal blog about art and digital technology: Next.js 16 + Headless WordPress.",
  "author": "Armando Monteiro",
  "license": "UNLICENSED",
  "keywords": [
    "nextjs",
    "headless-wordpress",
    "wpgraphql",
    "blog",
    "neobrutalism"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armandomonteir-o/armando-blog.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/load": "^21.2.4",
    "@next/bundle-analyzer": "^16.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
