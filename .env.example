# WordPress Headless CMS
WORDPRESS_API_URL=https://your-wordpress.com/graphql

# Secret that WordPress sends to POST /api/revalidate (ADR-014). Generate one with:
#   openssl rand -base64 32
# The same value goes in the WordPress config. Without it the route refuses every call.
REVALIDATE_SECRET=

# Public address of the site, used for the absolute URLs in sitemap.xml and robots.txt (#12).
# Optional: defaults to https://armando-blog.vercel.app. Set it when the domain changes.
NEXT_PUBLIC_SITE_URL=

# Vercel (auto-populated in Vercel deployments)
NEXT_PUBLIC_VERCEL_URL=

# Plausible Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Feature flags
NEXT_PUBLIC_ENABLE_COMMENTS=true
# Keep false until the newsletter really stores the e-mail (#112): only the exact string "true" shows the widget.
NEXT_PUBLIC_ENABLE_NEWSLETTER=false
# Keep false until there is a real notification system (#151, #43, #57): only the exact string "true" shows the bell.
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false
