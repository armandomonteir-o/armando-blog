# WordPress Headless CMS
WORDPRESS_API_URL=https://your-wordpress.com/graphql

# Secret that WordPress sends to POST /api/revalidate (ADR-014). Generate one with:
#   openssl rand -base64 32
# The same value goes in the WordPress config. Without it the route refuses every call.
REVALIDATE_SECRET=

# Vercel (auto-populated in Vercel deployments)
NEXT_PUBLIC_VERCEL_URL=

# Plausible Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Feature flags
NEXT_PUBLIC_ENABLE_COMMENTS=true
NEXT_PUBLIC_ENABLE_NEWSLETTER=true
